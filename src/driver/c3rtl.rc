// c3rtl.rc - RTL runtime library embedded as resources
// P10 (restored): RTL is embedded as .c/.h SOURCE and compiled by MSVC
// at user-program build time. The P11.3 pre-compiled .lib scheme was
// reverted: c3 is open source, no source protection needed.
// 6 .h headers + 15 .c sources (all arch-neutral) = 21 resources.
// Runtime: FindResource/LoadResource extract to temp session directory
// Paths relative to this RC file's location (src/driver/)

// Application icon (multi-size: 16/24/32/48/256, 32-bit ARGB)
1 ICON "c3.ico"

// Headers (needed for #include in generated code) + sources — arch-neutral
100 RCDATA "../rtl/core/vb6rtl.h"
101 RCDATA "../rtl/core/vb6rtl.c"
102 RCDATA "../rtl/core/vb6com.h"
103 RCDATA "../rtl/core/vb6com.c"
104 RCDATA "../rtl/core/vb6comserver.h"
105 RCDATA "../rtl/core/vb6comserver.c"
106 RCDATA "../rtl/core/vb6forms.h"
107 RCDATA "../rtl/core/vb6forms.c"
108 RCDATA "../rtl/core/vb6_di_stubs.c"
109 RCDATA "../rtl/core/vb6_di_win32_stubs.c"

// vb6comserver 按 COM 接口家族拆分 (P6.6): 内部共享头 + 各族实现
110 RCDATA "../rtl/core/vb6comserver_internal.h"
111 RCDATA "../rtl/core/vb6comserver_obj.c"
112 RCDATA "../rtl/core/vb6comserver_factory.c"
113 RCDATA "../rtl/core/vb6comserver_cp.c"
114 RCDATA "../rtl/core/vb6comserver_pci.c"

// vb6com 按 COM 调用层次拆分 (P6): 内部共享头 + 各层实现
115 RCDATA "../rtl/core/vb6com_internal.h"
116 RCDATA "../rtl/core/vb6com_invoke.c"
117 RCDATA "../rtl/core/vb6com_pack.c"
118 RCDATA "../rtl/core/vb6com_wrap.c"
119 RCDATA "../rtl/core/vb6com_sink.c"
120 RCDATA "../rtl/core/vb6com_foreach.c"
