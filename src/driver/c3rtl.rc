101 RCDATA "../rtl/core/vb6rtl.c"
102 RCDATA "../rtl/core/vb6com.h"
103 RCDATA "../rtl/core/vb6com.c"
104 RCDATA "../rtl/core/vb6comserver.h"
105 RCDATA "../rtl/core/vb6comserver.c"
106 RCDATA "../rtl/core/vb6forms.h"
107 RCDATA "../rtl/core/vb6forms.c"
