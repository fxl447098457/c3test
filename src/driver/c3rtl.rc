106 RCDATA "../rtl/core/vb6forms/vb6forms.h"
107 RCDATA "../rtl/core/vb6forms/vb6forms.c"
108 RCDATA "../rtl/core/di/vb6_di_stubs.c"
109 RCDATA "../rtl/core/di/vb6_di_win32_stubs.c"

