// c3rtl.rc - RTL runtime library embedded as resources
// P10 (restored): RTL is embedded as .c/.h SOURCE and compiled by MSVC
// at user-program build time. The P11.3 pre-compiled .lib scheme was
// reverted: c3 is open source, no source protection needed.
// 23 .h headers + 33 .c sources (all arch-neutral) = 56 resources.
// 2026-09-17 源文件按家族分目录: core/vb6rtl|vb6com|vb6comserver|vb6forms|di/,
// 解包后仍是平铺目录（RTL 内部 include 一律 basename，不受源目录影响）。
// Runtime: FindResource/LoadResource extract to temp session directory
// Paths relative to this RC file's location (src/driver/)

// Application icon (multi-size: 16/24/32/48/256, 32-bit ARGB)
1 ICON "c3.ico"

// Headers (needed for #include in generated code) + sources — arch-neutral
100 RCDATA "../rtl/core/vb6rtl/vb6rtl.h"
101 RCDATA "../rtl/core/vb6rtl/vb6rtl.c"
102 RCDATA "../rtl/core/vb6com/vb6com.h"
103 RCDATA "../rtl/core/vb6com/vb6com.c"
104 RCDATA "../rtl/core/vb6comserver/vb6comserver.h"
